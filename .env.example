# PAIO-Omni environment configuration
#
# Run `paio setup` to enter API keys interactively.
# Never commit your real .env file.

# ---------------------------------------------------------------------
# Optional cloud providers
# ---------------------------------------------------------------------

# ZenMux
ZENMUX_API_BASE=https://zenmux.ai/api/v1
ZENMUX_API_KEY=your_zenmux_key_here
ZENMUX_MODEL=z-ai/glm-5.3-free

# OpenRouter
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Groq
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_key_here

# TypeSafe / Jev role and complexity classification
TYPESAFE_API_KEY=your_typesafe_key_here

# ---------------------------------------------------------------------
# Piper TTS overrides
# ---------------------------------------------------------------------
#
# These are optional. Without them, PAIO searches for Piper under:
#
#   models/piper/piper.exe                    Windows
#   models/piper/piper                      Linux/macOS
#   models/piper/en_US-bryce-medium.onnx
#   models/piper/en_US-bryce-medium.onnx.json
#
# Windows example:
#
# PAIO_PIPER_EXE=C:\PAIO-OMNI\models\piper\piper.exe
# PAIO_PIPER_MODEL=C:\PAIO-OMNI\models\piper\en_US-bryce-medium.onnx
# PAIO_PIPER_CONFIG=C:\PAIO-OMNI\models\piper\en_US-bryce-medium.onnx.json
#
# Linux/macOS example:
#
# PAIO_PIPER_EXE=/opt/paio/models/piper/piper
# PAIO_PIPER_MODEL=/opt/paio/models/piper/en_US-bryce-medium.onnx
# PAIO_PIPER_CONFIG=/opt/paio/models/piper/en_US-bryce-medium.onnx.json

# ---------------------------------------------------------------------
# PAIO runtime data override
# ---------------------------------------------------------------------
#
# By default, PAIO stores config, logs, session data, and .env in an
# operating-system-specific user data directory.
#
# PAIO_DATA_DIR=/custom/path/to/paio-data
