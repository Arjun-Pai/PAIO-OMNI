# PAIO-Omni 3.2 — API keys
#
# You normally never edit this file directly — onboarding.py asks for
# each key interactively, tests it live, and writes the real ".env"
# itself. This file is just a reference for what ends up in it, or for
# setting things up by hand if you'd rather skip the interactive flow.

# === ZenMux (primary — tried first for everything) ===
ZENMUX_API_BASE=https://zenmux.ai/api/v1
ZENMUX_API_KEY=your_zenmux_key_here
ZENMUX_MODEL=z-ai/glm-5.3-free

# === OpenRouter (2nd — ranked list set in onboarding.py) ===
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# One-time tip: a $10 top-up on OpenRouter (never expires) raises the
# :free model daily cap from 50 to 1,000 requests.

# === Groq (3rd — ranked list set in onboarding.py) ===
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_key_here

# === Jev / TypeSafe AI (role + complexity classification) ===
TYPESAFE_API_KEY=your_typesafe_key_here

# Ollama Cloud (4th) needs no key here — auth is handled by
# `ollama signin`, which onboarding.py runs for you interactively.
# Ollama local (5th, last resort) needs no key at all.
